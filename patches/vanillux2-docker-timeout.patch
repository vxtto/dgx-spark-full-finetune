+        if type(environment).__name__ != "DockerEnvironment":
+            return await environment.exec(
+                command=self._wrap_command(command),
+                timeout_sec=self.command_timeout,
+            )
+        # Harbor's Daytona backend, which the paper evaluated on, runs commands
+        # as `timeout N bash -c ...` and hands exit code 124 back to the agent.
+        # Its Docker backend instead raises RuntimeError on timeout, which ends
+        # the whole trial. Enforce the limit inside the container the same way
+        # Daytona does, so a slow command costs the agent a turn, not the trial.
+        wrapped = (
+            f"timeout {self.command_timeout} bash -c "
+            f"{shlex.quote(self._wrap_command(command))}"
         )
+        try:
+            return await environment.exec(
+                command=wrapped,
+                timeout_sec=self.command_timeout + _EXEC_TIMEOUT_GRACE_SECONDS,
+            )
+        except RuntimeError as e:
+            # Backstop: a detached child can hold the output pipe open past the
+            # in-container timeout.
+            if "timed out" not in str(e):
+                raise
+            return ExecResult(
+                stdout=None, stderr=str(e), return_code=_TIMEOUT_EXIT_CODE
+            )
 
